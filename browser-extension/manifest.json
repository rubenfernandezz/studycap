{
  "manifest_version": 3,
  "name": "StudyCap · Local lecture capture",
  "version": "1.0.0",
  "description": "Review visible lecture captions in the local StudyCap application.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/import*"
      ],
      "js": [
        "import.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
